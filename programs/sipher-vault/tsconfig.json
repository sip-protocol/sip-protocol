{
  "compilerOptions": {
    "types": ["mocha", "node"],
    "typeRoots": ["./node_modules/@types"],
    "lib": ["es2020"],
    "module": "es2022",
    "target": "es2020",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "strict": false,
    "rootDir": ".",
    "sourceMap": true,
    "outDir": "./dist"
  },
  "include": [
    "tests/sipher-vault/1*-*.ts",
    "tests/sipher-vault/setup.ts",
    "tests/sipher-vault/bankrun-helpers.ts"
  ]
}
